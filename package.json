{
  "name": "grist-api-sdk",
  "version": "0.1.0",
  "description": "A modern, type-safe TypeScript SDK for the Grist REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "grist",
    "sdk",
    "api",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "bin": {
    "grist-sdk": "./bin/grist-sdk.js",
    "grist-typegen": "./bin/grist-sdk.js"
  }
}
