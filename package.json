{
  "name": "grist-api-sdk",
  "version": "0.2.1",
  "description": "A modern, type-safe TypeScript SDK for the Grist REST API",
  "author": "Supakarn Laorattanakul <wearedprompt@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/iamprompt/grist-api-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamprompt/grist-api-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/iamprompt/grist-api-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "grist-sdk": "./bin/grist-sdk.js",
    "grist-typegen": "./bin/grist-sdk.js"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "keywords": [
    "grist",
    "sdk",
    "api",
    "typescript",
    "grist-api",
    "client",
    "typegen",
    "database",
    "spreadsheet",
    "records"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
